#!/usr/bin/expect -f
set timeout 5
set choice [lindex $argv 0]
set command [lrange $argv 1 end]

spawn -noecho {*}$command

expect {
  -re {Choose \[d\]efault, \[p\]rofile, \[m\]erge, or \[s\]kip:} {
    send -- "$choice\r"
  }
  timeout {
    exit 124
  }
  eof {
    exit 125
  }
}

expect eof
set result [wait]
exit [lindex $result 3]

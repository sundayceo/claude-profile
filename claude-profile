#!/usr/bin/env bash
VERSION="0.2.0"
set -euo pipefail

DEFAULT_CONFIG="$HOME/.claude"
PROFILES_ROOT="$HOME/.claude-custom-profiles"
ACTIVE_PROFILE_FILE="$PROFILES_ROOT/.active-profile"
RELEASES_URL="https://github.com/sundayceo/claude-profile/releases"
INSTALL_URL="https://raw.githubusercontent.com/sundayceo/claude-profile/main/install.sh"

SHARED_ITEMS=(
  skills
  agents
  commands
)

CLAUDE_BIN="$(type -P claude || true)"

die() {
  echo "Error: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
Claude Profile Manager

Usage:
  claude-profile --create <name>
  claude-profile --delete <name>
  claude-profile --list
  claude-profile --use [name]
  claude-profile --profile <name> [-- <claude args>]
  claude-profile -P <name> [-- <claude args>]
  claude-profile --path <name>
  claude-profile --repair <name>
  claude-profile --repair --all
  claude-profile --version | -V
  claude-profile [command] --skip-version-check
  claude-profile --help

Default:
  default -> $DEFAULT_CONFIG

Custom profiles:
  $PROFILES_ROOT/<name>
EOF
}

show_version() {
  printf 'claude-profile %s\n' "$VERSION"
  printf 'Releases: %s\n' "$RELEASES_URL"
}

parse_global_args() {
  SKIP_VERSION_CHECK=0
  PARSED_ARGS=()

  local after_boundary=0
  local arg
  for arg in "$@"; do
    if [[ "$after_boundary" -eq 0 && "$arg" == "--" ]]; then
      after_boundary=1
      PARSED_ARGS+=("$arg")
    elif [[ "$after_boundary" -eq 0 && "$arg" == "--skip-version-check" ]]; then
      SKIP_VERSION_CHECK=1
    else
      PARSED_ARGS+=("$arg")
    fi
  done
}

is_newer_version() {
  local candidate="$1"
  local installed="$2"

  [[ "$candidate" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$installed" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1

  local candidate_major candidate_minor candidate_patch
  local installed_major installed_minor installed_patch
  IFS=. read -r candidate_major candidate_minor candidate_patch <<< "$candidate"
  IFS=. read -r installed_major installed_minor installed_patch <<< "$installed"

  if (( 10#$candidate_major != 10#$installed_major )); then
    (( 10#$candidate_major > 10#$installed_major ))
  elif (( 10#$candidate_minor != 10#$installed_minor )); then
    (( 10#$candidate_minor > 10#$installed_minor ))
  else
    (( 10#$candidate_patch > 10#$installed_patch ))
  fi
}

latest_version() {
  command -v curl >/dev/null 2>&1 || return 1

  local url version
  url="$(
    curl -fsSIL \
      --connect-timeout 1 \
      --max-time 2 \
      -o /dev/null \
      -w '%{url_effective}' \
      "$RELEASES_URL/latest" 2>/dev/null
  )" || return 1

  version="${url##*/}"
  version="${version#v}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$version"
}

should_check_for_update() {
  [[ "${SKIP_VERSION_CHECK:-0}" -eq 0 && -t 0 && -t 2 ]]
}

snooze_file() {
  printf '%s/claude-profile/version-check-snooze-until\n' \
    "${XDG_CACHE_HOME:-$HOME/.cache}"
}

is_snoozed() {
  local path deadline now
  path="$(snooze_file)"
  [[ -f "$path" ]] || return 1
  IFS= read -r deadline < "$path" || return 1
  [[ "$deadline" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  (( now < deadline ))
}

snooze_updates() {
  local path directory deadline tmp
  path="$(snooze_file)"
  directory="$(dirname "$path")"
  deadline=$(( $(date +%s) + 86400 ))
  tmp="$path.tmp.$$"

  mkdir -p "$directory" 2>/dev/null || return 1
  if ! printf '%s\n' "$deadline" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$path"; then
    rm -f "$tmp"
    return 1
  fi
}

install_update() {
  local tmp updated_bin
  tmp="$(mktemp)" || return 1

  if ! curl -fsSL "$INSTALL_URL" -o "$tmp"; then
    rm -f "$tmp"
    echo "Could not download the update. Continuing with the installed version." >&2
    return 1
  fi

  if ! bash "$tmp"; then
    rm -f "$tmp"
    echo "Could not install the update. Continuing with the installed version." >&2
    return 1
  fi
  rm -f "$tmp"

  updated_bin="${CLAUDE_PROFILE_INSTALL_DIR:-$HOME/.local/bin}/claude-profile"
  if [[ ! -x "$updated_bin" ]]; then
    echo "The update installed, but $updated_bin is not executable." >&2
    return 1
  fi
  exec "$updated_bin" --skip-version-check "$@"
}

check_for_update() {
  is_snoozed && return 0

  local latest choice
  latest="$(latest_version)" || return 0
  is_newer_version "$latest" "$VERSION" || return 0

  printf '\nclaude-profile %s → %s available\n\n' "$VERSION" "$latest" >&2

  while true; do
    echo '[o] Open release page' >&2
    echo '[u] Update now' >&2
    echo '[l] Remind me later (24 hours)' >&2
    printf '> ' >&2

    IFS= read -r -n 1 choice </dev/tty || return 0
    echo >&2

    case "$choice" in
      o|O)
        if command -v open >/dev/null 2>&1; then
          open "$RELEASES_URL" >/dev/null 2>&1 || \
            echo "Could not open $RELEASES_URL" >&2
        else
          echo "Releases: $RELEASES_URL" >&2
        fi
        return 0
        ;;
      u|U)
        install_update "$@" || true
        return 0
        ;;
      l|L)
        if ! snooze_updates; then
          echo 'Could not save the reminder. Continuing without snoozing.' >&2
        fi
        return 0
        ;;
      *)
        echo 'Choose o, u, or l.' >&2
        ;;
    esac
  done
}

validate_profile_name() {
  local name="$1"

  [[ -n "$name" ]] || die "Profile name cannot be empty."
  [[ "$name" != "default" ]] || die "'default' is reserved for $DEFAULT_CONFIG"

  [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || \
    die "Invalid profile name '$name'."
}

profile_path() {
  if [[ "$1" == "default" ]]; then
    printf '%s\n' "$DEFAULT_CONFIG"
  else
    printf '%s/%s\n' "$PROFILES_ROOT" "$1"
  fi
}

profile_exists() {
  [[ -d "$(profile_path "$1")" ]]
}

active_profile() {
  local name

  if [[ -f "$ACTIVE_PROFILE_FILE" ]]; then
    name="$(cat "$ACTIVE_PROFILE_FILE")"
  fi

  if [[ -n "${name:-}" ]] && \
     [[ "$name" != *$'\n'* ]] && \
     [[ "$name" == "default" || "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] && \
     profile_exists "$name"; then
    printf '%s\n' "$name"
  else
    printf '%s\n' default
  fi
}

set_active_profile() {
  local name="$1"

  if [[ "$name" != "default" ]]; then
    validate_profile_name "$name"
    profile_exists "$name" || die "Profile '$name' does not exist."
  fi

  local tmp="$ACTIVE_PROFILE_FILE.tmp.$$"
  printf '%s\n' "$name" > "$tmp"
  mv "$tmp" "$ACTIVE_PROFILE_FILE"
}

select_active_profile() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name="$(select_profile)"
  fi

  set_active_profile "$name"
  echo "Active profile: $name"
}

list_custom_profile_dirs() {
  [[ -d "$PROFILES_ROOT" ]] || return 0

  find "$PROFILES_ROOT" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -print 2>/dev/null | sort
}

create_shared_links() {
  local target="$1"
  local item source dest

  for item in "${SHARED_ITEMS[@]}"; do
    source="$DEFAULT_CONFIG/$item"
    dest="$target/$item"

    [[ -e "$source" || -L "$source" ]] || continue
    [[ -e "$dest" || -L "$dest" ]] || ln -s "$source" "$dest"
  done
}

create_profile() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "Usage: claude-profile --create <name>"

  validate_profile_name "$name"

  local target
  target="$(profile_path "$name")"

  [[ ! -e "$target" && ! -L "$target" ]] || \
    die "Profile '$name' already exists: $target"

  mkdir -p "$target"
  create_shared_links "$target"

  echo "Created profile:"
  echo "  Name: $name"
  echo "  Path: $target"
}

delete_profile() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "Usage: claude-profile --delete <name>"
  [[ "$name" != "default" ]] || die "Default profile cannot be deleted."

  validate_profile_name "$name"

  local target
  target="$(profile_path "$name")"

  [[ -d "$target" ]] || die "Profile '$name' does not exist: $target"

  echo "Delete:"
  echo "  $target"
  read -rp "Continue? [y/N] " answer

  local was_active=0
  if [[ -f "$ACTIVE_PROFILE_FILE" ]] && \
     [[ "$(cat "$ACTIVE_PROFILE_FILE")" == "$name" ]]; then
    was_active=1
  fi

  case "$answer" in
    y|Y|yes|YES)
      rm -rf "$target"
      if [[ "$was_active" -eq 1 ]]; then
        set_active_profile default
      fi
      echo "Deleted '$name'."
      ;;
    *)
      echo "Cancelled."
      ;;
  esac
}

list_profiles() {
  printf "%-20s %-10s %s\n" "PROFILE" "TYPE" "CONFIG DIRECTORY"
  printf "%-20s %-10s %s\n" "-------" "----" "----------------"
  printf "%-20s %-10s %s\n" "default" "default" "$DEFAULT_CONFIG"

  local dir
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    printf "%-20s %-10s %s\n" \
      "$(basename "$dir")" "custom" "$dir"
  done < <(list_custom_profile_dirs)
}

select_profile() {
  local profiles=("default")
  local dir i name path choice

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    profiles+=("$(basename "$dir")")
  done < <(list_custom_profile_dirs)

  echo "Choose Claude profile:" >&2
  echo >&2

  for i in "${!profiles[@]}"; do
    name="${profiles[$i]}"
    path="$(profile_path "$name")"

    printf "  %d) %-18s %s\n" \
      "$((i + 1))" "$name" "$path" >&2
  done

  echo >&2
  read -rp "Profile [1]: " choice </dev/tty
  choice="${choice:-1}"

  [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid selection."
  (( choice >= 1 && choice <= ${#profiles[@]} )) || die "Invalid selection."

  printf '%s\n' "${profiles[$((choice - 1))]}"
}

use_profile() {
  local name="$1"
  shift || true

  if [[ "$name" != "default" ]]; then
    profile_exists "$name" || die "Profile '$name' does not exist."
  fi

  [[ -n "$CLAUDE_BIN" ]] || die "Could not find Claude executable in PATH."

  local path
  path="$(profile_path "$name")"

  echo "Using Claude profile:"
  echo "  Name: $name"
  echo "  Path: $path"
  echo

  if [[ "$name" == "default" ]]; then
    unset CLAUDE_CONFIG_DIR
  else
    export CLAUDE_CONFIG_DIR="$path"
  fi

  exec "$CLAUDE_BIN" "$@"
}

show_path() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "Usage: claude-profile --path <name>"

  profile_exists "$name" || die "Profile '$name' does not exist."
  profile_path "$name"
}

repair_profile() {
  local name="$1"

  if [[ "$name" == "default" ]]; then
    echo "Default profile needs no repair:"
    echo "  $DEFAULT_CONFIG"
    return
  fi

  validate_profile_name "$name"

  local target
  target="$(profile_path "$name")"
  [[ -d "$target" ]] || die "Profile '$name' does not exist."

  echo "Repairing:"
  echo "  Name: $name"
  echo "  Path: $target"
  echo

  local item source dest current

  for item in "${SHARED_ITEMS[@]}"; do
    source="$DEFAULT_CONFIG/$item"
    dest="$target/$item"

    if [[ ! -e "$source" && ! -L "$source" ]]; then
      printf "  skip    %s (source missing)\n" "$item"
      continue
    fi

    if [[ -L "$dest" ]]; then
      current="$(readlink "$dest")"

      if [[ "$current" == "$source" ]]; then
        printf "  ok      %s -> %s\n" "$item" "$source"
      else
        rm "$dest"
        ln -s "$source" "$dest"
        printf "  repaired %s -> %s\n" "$item" "$source"
      fi

      continue
    fi

    if [[ -e "$dest" ]]; then
      printf "  skip    %s (existing non-symlink left untouched)\n" "$item"
      continue
    fi

    ln -s "$source" "$dest"
    printf "  created %s -> %s\n" "$item" "$source"
  done
}

repair_all_profiles() {
  local dir found=0

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    found=1
    repair_profile "$(basename "$dir")"
    echo
  done < <(list_custom_profile_dirs)

  [[ "$found" -eq 1 ]] || echo "No custom profiles found."
}

main() {
  parse_global_args "$@"
  if (( ${#PARSED_ARGS[@]} > 0 )); then
    set -- "${PARSED_ARGS[@]}"
  else
    set --
  fi

  mkdir -p "$PROFILES_ROOT"

  if should_check_for_update; then
    check_for_update "$@"
  fi

  case "${1:-}" in
  --create)
    create_profile "${2:-}"
    ;;
  --delete)
    delete_profile "${2:-}"
    ;;
  --list)
    list_profiles
    ;;
  --path)
    show_path "${2:-}"
    ;;
  --repair)
    case "${2:-}" in
      --all)
        repair_all_profiles
        ;;
      "")
        die "Usage: claude-profile --repair <name> | --repair --all"
        ;;
      *)
        repair_profile "$2"
        ;;
    esac
    ;;
  --use)
    select_active_profile "${2:-}"
    ;;
  --profile|-P)
    profile="${2:-}"
    [[ -n "$profile" ]] || die "Usage: claude-profile --profile <name> [-- <claude args>]"
    shift 2
    if [[ $# -gt 0 ]]; then
      [[ "$1" == "--" ]] || \
        die "Usage: claude-profile --profile <name> [-- <claude args>]"
      shift
    fi
    use_profile "$profile" "$@"
    ;;
  --help|-h)
    usage
    ;;
  --version|-V)
    show_version
    ;;
  "")
    use_profile "$(active_profile)"
    ;;
    *)
      die "Unknown option '$1'. Use --help."
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
